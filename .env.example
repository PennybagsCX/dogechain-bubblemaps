# Environment Variables Template
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control

# ===========================================
# SENTRY ERROR TRACKING
# ===========================================
# Get your DSN from: https://sentry.io/settings/projects/
# Create a free Sentry project and copy the DSN
SENTRY_DSN=your_sentry_dsn_here

# ===========================================
# AI FEATURES (OPTIONAL)
# ===========================================
# Google Gemini API Key for AI-powered analysis
# NOTE: For production security, implement a backend proxy
# Get your key from: https://makersuite.google.com/app/apikey
# Current: Disabled for open-source release (features work without it)
GEMINI_API_KEY=your_gemini_api_key_here

# ===========================================
# DOGEOS CHIKYU TESTNET (chain id 6281971)
# ===========================================
# These are informational: the app reads them from lib/chain.ts, which is the single
# source of truth. Overriding them here does NOT change the chain the app talks to.
DOGEOS_RPC_URL=https://rpc.testnet.dogeos.com/
DOGEOS_EXPLORER_URL=https://dogeos-testnet.l2scan.co
DOGEOS_EXPLORER_API=https://blockscout.testnet.dogeos.com/api
DOGEOS_EXPLORER_API_V2=https://blockscout.testnet.dogeos.com/api/v2
DOGEOS_FAUCET_URL=https://faucet.testnet.dogeos.com

# WalletConnect Cloud project id. Leave EMPTY to disable the WalletConnect connector
# (injected wallets keep working). Never commit a real id; never ship a placeholder.
VITE_WALLETCONNECT_PROJECT_ID=

# ===========================================
# APPLICATION SETTINGS
# ===========================================
# Application mode (development | production)
NODE_ENV=development

# Vite mode (development | production)
MODE=development

# ===========================================
# API RATE LIMITING
# ===========================================
# Maximum requests per minute to the explorer API
API_RATE_LIMIT_PER_MINUTE=60

# Retry attempts for failed API calls
API_MAX_RETRIES=3

# API request timeout in milliseconds
API_TIMEOUT=8000

# ===========================================
# FEATURE FLAGS
# ===========================================
# Enable AI-powered features (true | false)
FEATURE_AI_ENABLED=false

# Enable wallet connection (true | false)
FEATURE_WALLET_ENABLED=true

# Enable dashboard/alerts (true | false)
FEATURE_DASHBOARD_ENABLED=true

# Enable analytics tracking (true | false)
FEATURE_ANALYTICS_ENABLED=false

# Enable learning search system (true | false)
# Crowdsourced token discovery from wallet scans
VITE_LEARNING_ENABLED=true

# Enable background sync for learned data (true | false)
# Periodically syncs crowdsourced tokens from server
VITE_BACKGROUND_SYNC_ENABLED=true

# ===========================================
# ANALYTICS (OPTIONAL)
# ===========================================
# Google Analytics ID
# VITE_GA_ID=G-XXXXXXXXXX

# PostHog API Key
# VITE_POSTHOG_KEY=your_posthog_key
# VITE_POSTHOG_HOST=https://app.posthog.com

# ===========================================
# API BACKEND URL
# ===========================================
# Base URL for backend API (where /api/* endpoints are hosted)
# For local development, use empty string or "/api" (proxied)
# Leave empty to use this fork's own deployment. Do NOT point a DogeOS build at the
# upstream Dogechain production backend.
VITE_API_BASE_URL=

# ===========================================
# SEARCH ANALYTICS API (DEPRECATED)
# ===========================================
# Analytics API backend URL for search learning system
# NOTE: Use VITE_API_BASE_URL instead (this is kept for backward compatibility)
# VITE_ANALYTICS_API_ENDPOINT=https://dogechain-bubblemaps-api.vercel.app

# ===========================================
# BUILD SETTINGS
# ===========================================
# Disable source maps in production for security
# VITE_DISABLE_SOURCEMAP=true

# Enable bundle analysis
# VITE_BUNDLE_ANALYZE=true

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
# Enable debug mode (shows additional logs)
DEBUG=false

# Log level (error | warn | info | debug)
LOG_LEVEL=info

# ===========================================
# DEPLOYMENT SETTINGS
# ===========================================
# Deployment URL (for generating canonical URLs)
# VITE_DEPLOY_URL=https://your-domain.com

# ===========================================
# NOTES
# ===========================================
# 1. Never commit .env.local to version control
# 2. Use .env.example as a template only
# 3. All values in .env.local override these defaults
# 4. For production, use environment variables in your hosting platform
# 5. API keys should be kept server-side via backend proxy when possible
